{
  "name": "wiki-flujos-libreta-compartida",
  "private": true,
  "type": "module",
  "description": "Tutorial narrado de la wiki de LegacyEnterprise: «Una sola libreta para todos los módulos» (flujos/libreta-compartida).",
  "scripts": {
    "preparar:es": "node ../_herramientas/tutorial-wiki.mjs preparar --idioma es",
    "preparar:en": "node ../_herramientas/tutorial-wiki.mjs preparar --idioma en",
    "dev": "npx --yes hyperframes@0.8.62 preview",
    "check": "npx --yes hyperframes@0.8.62 check",
    "render:es": "npx --yes hyperframes@0.8.62 render --quality high --output renders/tutorial-es.mp4",
    "render:en": "npx --yes hyperframes@0.8.62 render --quality high --output renders/tutorial-en.mp4",
    "entregar:es": "node ../_herramientas/tutorial-wiki.mjs entregar --idioma es",
    "entregar:en": "node ../_herramientas/tutorial-wiki.mjs entregar --idioma en"
  }
}
